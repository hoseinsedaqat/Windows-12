{
  "name": "windows-12-concept-web-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Windows 12 Concept — Web Desktop Simulator (unofficial fan-made concept, not affiliated with Microsoft)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
